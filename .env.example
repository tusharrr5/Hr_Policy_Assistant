# ── HR Policy Assistant — Environment Variables ──
# Uncomment and set ONE of these API keys (auto-detect picks the first found):

# GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key

# Force a specific provider instead of auto-detect:
# LLM_PROVIDER=auto   # auto | google | gemini | groq | openai

# Override the default model name for the chosen provider:
# MODEL_NAME=gemini-2.5-flash
